{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppResearchRow",
  "description": "One researched app. Prefer unknown over a guess. Every non-unknown field should have evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "one_liner",
    "auth_methods",
    "access",
    "api_type",
    "api_breadth",
    "mcp",
    "verdict",
    "blocker",
    "evidence_urls",
    "confidence",
    "notes",
    "needs_human"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 100 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "one_liner": { "type": "string" },
    "auth_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["oauth2", "api_key", "basic", "token", "other", "unknown"]
      }
    },
    "access": {
      "type": "string",
      "enum": ["self_serve", "trial", "paid", "admin", "partner_gated", "unknown"]
    },
    "api_type": {
      "type": "string",
      "enum": ["rest", "graphql", "rest_and_graphql", "none", "unknown"]
    },
    "api_breadth": {
      "type": "string",
      "enum": ["narrow", "medium", "broad", "unknown"]
    },
    "mcp": {
      "type": "string",
      "enum": ["official", "community", "none", "unknown"]
    },
    "verdict": {
      "type": "string",
      "enum": ["toolkit_today", "possible_with_work", "blocked", "unknown"]
    },
    "blocker": { "type": ["string", "null"] },
    "evidence_urls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string" },
    "needs_human": { "type": "boolean" }
  }
}
